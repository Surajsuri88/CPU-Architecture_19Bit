module PCControl (

    input wire [18:0] immediate,
    input wire [18:0] stack_data,
    input wire B_branch,

    input wire [4:0] B_write_reg,


    input wire jump,
    input wire push,
    input wire pop,
    input wire alu_zero,
    input wire [18:0] pc_added,
    output reg [18:0] next_pc
);
    always @(*) begin
        if (jump) begin

	    	if( jump ==1 && push==0 && pop==0)begin
	        	next_pc = immediate;
            	end 
		else if (push) begin
                	next_pc = immediate; //CALL
            	end 
		else if (pop) begin
                	next_pc = stack_data; //RET
            	end
	 	else begin
                	next_pc = pc_added;
            	end
        end 

	else if (B_branch) begin //BEQ and BNE
            next_pc = B_write_reg;
        end else begin
            next_pc = pc_added;
        end
    end
endmodule
